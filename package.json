{
  "name": "nexus-alexa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alexa+ -> Nexus Semantic -> real cross-substrate execution. Amazon Alexa+ Hackathon 2026.",
  "license": "Apache-2.0",
  "author": "Mbuso-Harvey",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "bin": {
    "nexus-alexa": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "tsx src/cli.ts serve",
    "serve:dist": "node dist/src/cli.js serve",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1136.0",
    "@aws-sdk/credential-providers": "^3.1136.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
